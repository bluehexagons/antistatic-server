          "ticket_count": { "type": "integer", "minimum": 0 },
          "match_count": { "type": "integer", "minimum": 0 },
          "tag_lease_count": { "type": "integer", "minimum": 0 },
          "lobbies_created": { "type": "integer", "minimum": 0 },
          "successful_matches": { "type": "integer", "minimum": 0 },
          "queue_attempt_count": { "type": "integer", "minimum": 0 },
          "match_connection_success_count": { "type": "integer", "minimum": 0 },
          "match_connection_failure_count": { "type": "integer", "minimum": 0 },
          "queue_cancellation_count": { "type": "integer", "minimum": 0 },
          "queue_expiration_count": { "type": "integer", "minimum": 0 },
          "http_error_count": { "type": "integer", "minimum": 0 },
          "game_error_count": { "type": "integer", "minimum": 0 },
          "http_errors": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/RecentHTTPError" } },
          "game_errors": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/RecentGameError" } },
          "activity": { "$ref": "#/components/schemas/ActivitySummary" },
          "events": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/CommunityQueueEvent" } },
